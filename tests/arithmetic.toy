assert_equal(1 + 2 + 3 + 4, 10);
assert_equal((1 + 2) * (3 / 4), 2.25);
assert_not_equal(1 + 2, 3 / 4);
var neg = -123.45;
assert_equal(neg, -123.45);
var pos = -67.89 / -1.02;
var sixty = 28 * 2 + 4, noval, bignum = 12345678.9;
assert_equal(sixty, 60);
var eighty = sixty + 20;
assert_equal(eighty, 80);
